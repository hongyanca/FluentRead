{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": "..",
    "paths": {
      "@/src/ui/i18n": ["storybook/preview-i18n.ts"],
      "@/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.vue", "../.storybook/**/*.ts"]
}
