      "[contenteditable=\"true\"]",
      "time",
      "cite"
    ],
    "exclude": [
      "nav",
      "[role=\"navigation\"]",
      "[role=\"search\"]",
      "[role=\"tablist\"]",
      "[role=\"toolbar\"]",
      "[role=\"menu\"]",
      "header:not(article header) p",
      "header:not(article header) li",
      "header:not(article header) dd",
      "header:not(article header) blockquote",
      "header:not(article header) figcaption",
      "footer:not(article footer) p",
      "footer:not(article footer) li",
      "footer:not(article footer) dd",
      "footer:not(article footer) blockquote",
      "footer:not(article footer) figcaption",
      "aside:not(article aside):not(main aside):not([role=\"main\"] aside)",
      "aside:not(article aside):not([role=\"note\"]):not(.admonition):not(.callout):not(.caution):not(.important):not(.note):not(.notice):not(.tip):not(.warning)",
      "[role=\"complementary\"]",
      "[role=\"dialog\"]",
      "form"
    ]
  }
}
